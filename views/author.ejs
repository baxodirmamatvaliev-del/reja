              <div class="foiz-3">
                <div></div>
              </div>
            </div>
            <div class="language-item">
              <div class="language-info">
                <span><%=user.skills[3]%></span>
                <span>0%</span>
              </div>
              <div class="foiz-4">
                <div></div>
              </div>
            </div>
            <div class="language-item">
              <div class="language-info">
                <span><%=user.skills[4]%></span>
                <span>40%</span>
              </div>
              <div class="foiz-5">
                <div></div>
              </div>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_5">
            <div class="leaguage-top-2">
              <span>Extra Skill</span>
            </div>
            <div class="extra_1">
              <img src="icon/icons.svg" alt="" />
