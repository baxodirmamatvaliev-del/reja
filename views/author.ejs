                </div>
              </a>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_2">
            <div class="info-row">
              <span class="label">Age:</span>
              <span class="value"><%=user.age%></span>
            </div>

            <div class="info-row">
              <span class="label">Residence:</span>
              <span class="value"><%=user.residence%></span>
            </div>

            <div class="info-row">
              <span class="label">Frelance:</span>
              <span class="status-available">Available</span>
            </div>

            <div class="info-row">
              <span class="label">Address:</span>
              <span class="value"><%=user.adress%></span>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_3">
            <div class="language-item">
              <div class="leaguage-top">
                <span>languages</span>
              </div>
              <div class="language-info">
                <span><%=user.languages[0]%></span>
                <span>100%</span>
              </div>
              <div class="foiz">
                <div></div>
              </div>
            </div>
            <div class="language-item">
              <div class="language-info">
                <span><%=user.languages[1]%></span>
                <span>90%</span>
              </div>
              <div class="foiz-2">
                <div></div>
              </div>
            </div>
            <div class="language-item">
              <div class="language-info">
                <span><%=user.languages[2]%></span>
                <span>60%</span>
              </div>
              <div class="foiz-3">
                <div></div>
              </div>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_4">
            <div class="language-item">
              <div class="leaguage-top">
                <span>Skill</span>
              </div>
              <div class="language-info">
                <span><%=user.skills[0]%></span>
                <span>100%</span>
              </div>
              <div class="foiz">
                <div></div>
              </div>
            </div>
            <div class="language-item">
              <div class="language-info">
                <span><%=user.skills[1]%></span>
                <span>90%</span>
              </div>
              <div class="foiz-2">
                <div></div>
